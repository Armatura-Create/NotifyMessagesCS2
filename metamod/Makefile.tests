# Локальная проверка ЯДРА плагина: без hl2sdk и без Metamod.
#
# Почти вся логика (конфиг, рендер каналов, локализация, реклама, разбор A2S,
# GeoIP) движка не требует, а hl2sdk на macOS не собирается вовсе. Всё, что
# зависит от SDK, живёт в src/mm и проверяется только в CI.
#
#   make -f Makefile.tests -j8 && ./build-tests/nm_tests

CXX      ?= c++
CXXSTD   ?= -std=c++17
CXXFLAGS ?= $(CXXSTD) -O1 -g -Wall -Wextra -Wpedantic -Werror
INCLUDES  = -Isrc -Isrc/vendorcfg -Ivendor/doctest/doctest -Ivendor/json/single_include \
            -Ivendor/libmaxminddb/include -Ivendor/libmaxminddb/src
LDLIBS   ?= -lpthread

OUT       = build-tests
BIN       = $(OUT)/nm_tests

CORE_SRC  = $(wildcard src/core/*.cpp) $(wildcard src/core/util/*.cpp)
TEST_SRC  = $(wildcard tests/*.cpp)
OBJ       = $(patsubst %.cpp,$(OUT)/%.o,$(CORE_SRC) $(TEST_SRC))

# libmaxminddb собирается одним файлом-обёрткой (он же добавляет открытие из
# памяти вместо mmap). Предупреждения чужого кода не наши — -Werror тут не к месту.
C_SRC     = src/core/geoip_maxminddb.c vendor/libmaxminddb/src/data-pool.c
C_OBJ     = $(patsubst %.c,$(OUT)/%.o,$(C_SRC))
OBJ      += $(C_OBJ)
CC       ?= cc
CFLAGS   ?= -std=c99 -O1 -g -w

all: $(BIN)

$(BIN): $(OBJ)
	$(CXX) $(CXXFLAGS) -o $@ $(OBJ) $(LDLIBS)

# -MMD -MP: объект зависит от заголовков, которые включает. Без этого правка
# config.h пересобирала бы только изменённые руками .cpp.
$(OUT)/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -MMD -MP -c $< -o $@

-include $(OBJ:.o=.d)

$(OUT)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

# Игровая сборка идёт с -fno-exceptions (так собран весь hl2sdk), и в этом режиме
# nlohmann/json на ошибке зовёт std::abort() вместо броска: кривой конфиг убивал
# бы сервер. Тесты собираются С исключениями (их требует doctest), поэтому
# проверка отдельная — и со стандартом c++20, как у AMBuild.
GAMEFLAGS ?= -std=c++20 -fno-exceptions -fsyntax-only -Wall -Wextra -Werror

noexcept-check:
	@for f in $(CORE_SRC); do \
		$(CXX) $(GAMEFLAGS) $(INCLUDES) $$f || exit 1; \
	done
	@echo "core compiles as the game build does (c++20, -fno-exceptions)"

# AMBuilder перечисляет исходники ядра руками, а тесты берут их маской. Забытый
# в AMBuilder файл собирается локально и падает только в игровой сборке.
sources-check:
	@for f in $(CORE_SRC) $(C_SRC); do \
		grep -q "'$$f'" AMBuilder || { \
			echo "AMBuilder не собирает $$f"; exit 1; }; \
	done
	@echo "AMBuilder собирает все файлы ядра"

clean:
	rm -rf $(OUT)

.PHONY: all clean noexcept-check sources-check
